FROM node:24.19.0-alpine AS build
WORKDIR /workspace/FrontEnd

RUN corepack enable

COPY FrontEnd/package.json FrontEnd/pnpm-lock.yaml FrontEnd/pnpm-workspace.yaml FrontEnd/.npmrc ./
COPY FrontEnd/apps/admin ./apps/admin
COPY FrontEnd/packages/admin-common ./packages/admin-common
COPY FrontEnd/packages/api-contract ./packages/api-contract

RUN corepack pnpm install --filter admin... --frozen-lockfile \
    && corepack pnpm --filter admin build:prod

FROM nginx:1.27-alpine
COPY infra/nginx/web/admin-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/FrontEnd/apps/admin/dist/ /usr/share/nginx/html/
