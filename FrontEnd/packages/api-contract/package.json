{
  "name": "@springmsa/api-contract",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "pnpm run generate:member && pnpm run generate:admin",
    "generate:member": "openapi-typescript http://localhost:8082/v3/api-docs -o src/generated/member-api.d.ts",
    "generate:admin": "openapi-typescript http://localhost:8087/v3/api-docs -o src/generated/admin-api.d.ts",
    "build": "tsc --noEmit",
    "test": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
